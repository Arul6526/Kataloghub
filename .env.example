# Supabase
# Untuk dev lokal: jalankan `supabase start` lalu salin URL & anon key dari output.
# Untuk remote project: isi dengan URL & anon key project Supabase Anda.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-remote-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-keep-secret

# Public site URL (untuk metadata & canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Admin Platform (untuk tombol order/pilih paket di halaman promo & admin)
NEXT_PUBLIC_ADMIN_WA=6281234567890

# Sumopod Payment Gateway
SUMOPOD_PAY_API_KEY=your-sumopod-pay-api-key
SUMOPOD_PAY_BASE_URL=https://api-pay-sandbox.sumopod.com/api/v1
SUMOPOD_WEBHOOK_SECRET=whsec_replace-with-svix-webhook-secret
# Aktifkan hanya untuk pengujian lokal; jangan aktifkan di production.
SUMOPOD_SANDBOX_SIMULATION_ENABLED=false

# AI Assistant: base64 dari 32 byte random key. Generate dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_SETTINGS_ENCRYPTION_KEY=replace-with-base64-32-byte-key
